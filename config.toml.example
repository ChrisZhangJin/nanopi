# nanopi config.toml
#
# Loaded from two locations (both optional, project overrides global):
#   1. ~/.nanopi/config.toml        (global — user-wide defaults)
#   2. <cwd>/.nanopi/config.toml    (project-local — overrides global)
#
# Precedence for any given value:
#   --flag  >  OPENAI_* env var  >  project config  >  global config  >  default/error
#
# Every field below is optional. Copy this file to
# ~/.nanopi/config.toml (or ./.nanopi/config.toml) and edit as needed.

# ─── Model / endpoint ────────────────────────────────────────────────

# Model identifier (whatever the provider expects).
model = "gpt-5"

# OpenAI-compatible endpoint. Set this when using a proxy, self-hosted
# gateway, or non-OpenAI provider (DeepSeek, Gemini via gateway, etc.).
base_url = "https://api.openai.com/v1"

# Wire protocol spoken at `base_url`. Defaults to "openai" — the
# de-facto OpenAI chat/completions surface used by OpenAI, DeepSeek,
# oneapi/newapi/litellm, ollama, vLLM, etc. Set to "anthropic" when
# the endpoint speaks Anthropic's native Messages API instead (path
# suffix `/v1/messages`) — e.g. Anthropic direct, or a vendor's
# Anthropic-compat surface like `https://api.minimaxi.com/anthropic`.
# Wrong choice here means requests hit the wrong path → 404.
#
# Leaving it unset is usually best: the vendor infers the protocol from
# base_url, and a `…/anthropic` path selects the Anthropic wire
# automatically. Setting it explicitly overrides that inference.
# api_kind = "openai"      # default when nothing can be inferred
# api_kind = "anthropic"

# Vendor id, normally inferred from base_url/model. Set it only to
# override a wrong guess — it selects thinking-parameter shape and the
# default transport. One of: openai, anthropic, deepseek, zai, qwen,
# minimax, xiaomi, fallback.
# provider = "xiaomi"

# ─── Xiaomi MiMo (Token Plan) — both surfaces work ──────────────────
#
# Anthropic-native:
#   model = "mimo-v2.5-pro"
#   base_url = "https://token-plan-cn.xiaomimimo.com/anthropic"
# OpenAI-compat:
#   model = "mimo-v2.5-pro"
#   base_url = "https://token-plan-cn.xiaomimimo.com/v1"
#
# Use the `-sgp` host instead of `-cn` for a Singapore Token Plan. Note
# MiMo ignores `cache_control` and `thinking.budget_tokens` on its
# Anthropic surface, so thinking budgets there are advisory only.

# ─── Tool execution (v0.11.0) ───────────────────────────────────────

# How tool calls from a single LLM response are run.
#   "parallel"   (default) all calls run concurrently
#   "sequential" one at a time, in the order the model emitted them
#
# Sequential is for stateful chains where order matters — e.g. a
# `write` whose output the next `read` must see. It is slower; leave
# it on the default unless you hit an ordering bug.
# tool_exec_mode = "sequential"

# ─── WASM extensions (v0.11.0) ──────────────────────────────────────
#
# Requires a build with `--features wasm`. The stock release binary
# does NOT include the runtime — entries here are ignored with a
# warning on stderr.
#
# Each entry points at a `.wasm` component, or a directory of them
# (scanned one level deep, non-recursive). Tools the component
# exports are registered alongside the built-ins and offered to the
# model like any other tool. A plugin may not shadow an existing tool
# name; collisions are reported and skipped.
#
# Fields:
#   path            .wasm file or directory. Supports ~ and $HOME.
#   max_files       Cap when path is a directory. Default 64.
#   allow_fs        Let the plugin call host-fs-read. Default false.
#                   Even when true, reads are confined to the working
#                   directory: paths are canonicalized first, so `../`
#                   and outward-pointing symlinks are refused.
#   allow_network   Let the plugin call host-http-get. Default false.
#                   Only http/https; requests time out after 10s, and
#                   redirects are not followed, so a 3xx cannot walk a
#                   fetch onto a host you did not approve.
#   url_allowlist   Hosts host-http-get may reach. EMPTY DENIES
#                   EVERYTHING — allow_network alone reaches nothing.
#                   Matching is on the URL's host, so an entry covers
#                   its subdomains and any port ("github.com" allows
#                   api.github.com:8443) but not a host that merely
#                   ends with it ("evilgithub.com" is refused).
#                   Effective only when allow_network = true.
#
# See docs/pi-vs-nanopi.md §4.3 and wit/nanopi-extension.wit for the
# guest interface a plugin must export.

# [[extensions]]
# path = "~/.nanopi/extensions/my-tool.wasm"

# [[extensions]]
# path = "~/.nanopi/extensions/"
# max_files = 16

# ─── API key: pick ONE of the two below ─────────────────────────────

# Option A — file (recommended). Path to a chmod-600 file containing
# just the token. `~/` expands to $HOME.
# api_key_file = "~/.nanopi/api_key"

# Option B — inline (convenient for local dev). A stderr warning fires
# at startup so you don't accidentally commit this file with the key.
# api_key = "sk-..."

# ─── Trust default (optional) ───────────────────────────────────────

# Overrides the interactive trust prompt for project-local resources.
# One of: "trusted", "distrusted", "ask" (default).
# [trust]
# default = "trusted"

# ─── Hooks ──────────────────────────────────────────────────────────
#
# Each hook is a bash command run at a lifecycle event.
# Fields:
#   matcher  regex against tool_name (or session_id for session_*).
#            Defaults to "*" (match all) — required-looking blocks
#            that omit it work fine.
#   type     "command" (only value in v0.6+); optional.
#   command  Path/expression run via `bash -c "..."`. Supports ~,
#            $HOME, ${HOME}.
#   timeout  Milliseconds. Default 5000.
#
# The hook receives a JSON payload on stdin describing the event.
# Exit code 2 (or a JSON stdout {"decision":"block"}) blocks the
# tool call; anything else allows.
#
# All hook vectors are cumulative — multiple hooks of the same type
# fire in declaration order.

# Ex 1: veto dangerous rm invocations before bash runs them.
# [[hooks.pre_tool_use]]
# matcher = "^bash$"
# command = "~/.nanopi/hooks/check-rm-rf.sh"
# timeout = 5000

# Ex 2: log every tool result to a file for later audit.
# [[hooks.post_tool_use]]
# matcher = "*"
# command = "cat >> ~/.nanopi/tool-audit.log"

# Ex 3: refuse prompts that contain a specific secret pattern.
# [[hooks.user_prompt_submit]]
# command = "~/.nanopi/hooks/redact-secrets.sh"

# Ex 4: notify on session start (matcher defaults to "*"; session_id
# is what the matcher runs against for session_* events).
# [[hooks.session_start]]
# command = "echo \"[nanopi] session started at $(date)\" >> ~/.nanopi/sessions.log"

# Ex 5: run cleanup on session exit.
# [[hooks.session_end]]
# command = "~/.nanopi/hooks/cleanup.sh"

# ── v0.11.0 lifecycle hooks ─────────────────────────────────────────
# These map to PI's before_agent_start / turn_start / turn_end /
# message_end. See docs/pi-vs-nanopi.md §4.3 for the full list.

# Ex 6: log every turn start for debugging.
# [[hooks.before_agent_start]]
# matcher = "*"
# command = "echo \"turn $TURN_COUNT started\" >> ~/.nanopi/turns.log"
# timeout = 2000

# Ex 7: audit each agent-loop iteration.
# [[hooks.turn_start]]
# matcher = "*"
# command = "echo \"[turn_start] iter=$ITERATION\" >> ~/.nanopi/agent.log"
# timeout = 2000

# Ex 8: track tool usage across iterations.
# [[hooks.turn_end]]
# matcher = "*"
# command = "echo \"[turn_end] had_tools=$HAD_TOOL_CALLS\" >> ~/.nanopi/agent.log"
# timeout = 2000

# Ex 9: fire a notification when a turn completes.
# [[hooks.message_end]]
# matcher = "*"
# command = "notify-send \"nanopi turn done\""
# timeout = 2000
