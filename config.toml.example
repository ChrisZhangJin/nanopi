# nanopi config.toml
#
# Loaded from two locations (both optional, project overrides global):
#   1. ~/.nanopi/config.toml        (global — user-wide defaults)
#   2. <cwd>/.nanopi/config.toml    (project-local — overrides global)
#
# Precedence for any given value:
#   --flag  >  OPENAI_* env var  >  project config  >  global config  >  default/error
#
# Every field below is optional. Copy this file to
# ~/.nanopi/config.toml (or ./.nanopi/config.toml) and edit as needed.

# ─── Model / endpoint ────────────────────────────────────────────────

# Model identifier (whatever the provider expects).
model = "gpt-5"

# OpenAI-compatible endpoint. Set this when using a proxy, self-hosted
# gateway, or non-OpenAI provider (DeepSeek, Gemini via gateway, etc.).
base_url = "https://api.openai.com/v1"

# Wire protocol spoken at `base_url`. Defaults to "openai" — the
# de-facto OpenAI chat/completions surface used by OpenAI, DeepSeek,
# oneapi/newapi/litellm, ollama, vLLM, etc. Set to "anthropic" when
# the endpoint speaks Anthropic's native Messages API instead (path
# suffix `/v1/messages`) — e.g. Anthropic direct, or a vendor's
# Anthropic-compat surface like `https://api.minimaxi.com/anthropic`.
# Wrong choice here means requests hit the wrong path → 404.
#
# Leaving it unset is usually best: the vendor infers the protocol from
# base_url, and a `…/anthropic` path selects the Anthropic wire
# automatically. Setting it explicitly overrides that inference.
# api_kind = "openai"      # default when nothing can be inferred
# api_kind = "anthropic"

# Vendor id, normally inferred from base_url/model. Set it only to
# override a wrong guess — it selects thinking-parameter shape and the
# default transport. One of: openai, anthropic, deepseek, zai, qwen,
# minimax, xiaomi, fallback.
# provider = "xiaomi"

# ─── Xiaomi MiMo (Token Plan) — both surfaces work ──────────────────
#
# Anthropic-native:
#   model = "mimo-v2.5-pro"
#   base_url = "https://token-plan-cn.xiaomimimo.com/anthropic"
# OpenAI-compat:
#   model = "mimo-v2.5-pro"
#   base_url = "https://token-plan-cn.xiaomimimo.com/v1"
#
# Use the `-sgp` host instead of `-cn` for a Singapore Token Plan. Note
# MiMo ignores `cache_control` and `thinking.budget_tokens` on its
# Anthropic surface, so thinking budgets there are advisory only.

# ─── Tool execution (v0.11.0) ───────────────────────────────────────

# How tool calls from a single LLM response are run.
#   "parallel"   (default) all calls run concurrently
#   "sequential" one at a time, in the order the model emitted them
#
# You do NOT need sequential to make same-file edits safe. In parallel
# mode, `edit` and `write` calls targeting the same file are detected
# (by resolved path, so `foo.txt` and `./foo.txt` count as one file)
# and run one after another in the order the model emitted them.
# Different files still run concurrently.
#
# What sequential is actually for:
#
#   1. Concurrent `bash` data loss. `bash` is NOT serialized — a
#      command string cannot be analyzed to know which files it
#      touches, so nanopi does not try. Two same-batch `bash` calls
#      doing a read-modify-write of one file (`sed -i`, a formatter, a
#      codemod) can each snapshot the file before the other writes, and
#      whichever finishes last silently reverts the other. Both report
#      success; nothing surfaces the loss. Sequential is the mitigation:
#      the first command is awaited to completion before the second is
#      spawned at all.
#   2. Stateful chains where order matters across different tools —
#      e.g. a `write` whose result the next `bash` must see.
#
# The cost is real: sequential serializes the *entire* batch, including
# reads and greps that had no reason to wait. Reach for it if the model
# is driving shell-based rewrites of the same files, or if you hit an
# ordering bug; otherwise leave the default.
# tool_exec_mode = "sequential"

# ─── WASM extensions (v0.11.0) ──────────────────────────────────────
#
# Requires a build with `--features wasm`. The stock release binary
# does NOT include the runtime — entries here are ignored with a
# warning on stderr.
#
# Each entry points at a `.wasm` component, or a directory of them
# (scanned one level deep, non-recursive). Tools the component
# exports are registered alongside the built-ins and offered to the
# model like any other tool. A plugin may not shadow an existing tool
# name; collisions are reported and skipped.
#
# A component may also export slash commands (`list-commands` /
# `execute-command`), which appear in the `/` palette tagged with the
# plugin's name. Those are interactive-mode only — `nanopi -p` has no
# palette, though the plugin's tools still work there. Command
# collisions are refused rather than renamed: a name belonging to a
# built-in is skipped, and a name claimed by two plugins registers
# for neither.
#
# Plugins load once per Agent — at startup and on /new, /resume,
# /fork, /import. `/reload` does NOT re-read this section.
#
# Fields:
#   path            .wasm file or directory. Supports ~ and $HOME.
#   max_files       Cap when path is a directory. Default 64.
#   allow_fs        Let the plugin call host-fs-read. Default false.
#                   Even when true, reads are confined to the working
#                   directory: paths are canonicalized first, so `../`
#                   and outward-pointing symlinks are refused.
#   allow_network   Let the plugin call host-http-get. Default false.
#                   Only http/https; requests time out after 10s, and
#                   redirects are not followed, so a 3xx cannot walk a
#                   fetch onto a host you did not approve.
#   url_allowlist   Hosts host-http-get may reach. EMPTY DENIES
#                   EVERYTHING — allow_network alone reaches nothing.
#                   Matching is on the URL's host, never a substring.
#                   Three spellings:
#                     "github.com"    the host AND its subdomains, any
#                                     port (api.github.com:8443 passes;
#                                     evilgithub.com does not)
#                     "*.github.com"  subdomains ONLY — the apex
#                                     github.com is refused
#                     "*"             any http/https host. For plugins
#                                     whose hosts aren't knowable up
#                                     front. This turns the second gate
#                                     off: allow_network becomes the
#                                     only check, link-local metadata
#                                     endpoints (169.254.169.254)
#                                     included. nanopi warns at startup
#                                     when it sees this.
#                   A star anywhere else ("api.*.com") is refused
#                   rather than widened. Effective only when
#                   allow_network = true.
#   events          Lifecycle events this plugin may OBSERVE (v0.12.0).
#                   Absent or empty grants NOTHING — a plugin exporting
#                   `list-events` still receives no deliveries until its
#                   requests appear here too. Delivery needs the event
#                   in BOTH this list AND the plugin's own `list-events`
#                   export; either alone is not enough. PI's eleven
#                   event names (same vocabulary as [[hooks.*]] below):
#                     tool_execution_start, tool_execution_end, input,
#                     before_agent_start, turn_start, turn_end,
#                     message_end, session_start, session_shutdown,
#                     session_before_compact, session_compact
#                   A subscriber is OBSERVE-ONLY — it cannot block or
#                   transform, unlike a shell hook. But the grant is
#                   real: a `tool_execution_start` subscriber sees every
#                   tool call's arguments, and an `input` subscriber
#                   sees every prompt verbatim — a bigger surface than
#                   `allow_fs`. Combining `events` with
#                   `allow_network = true` on the same plugin is warned
#                   about at startup: it can exfiltrate whatever those
#                   events carry. `/tools` lists every plugin currently
#                   watching, under "Watching events".
#
# See docs/pi-vs-nanopi.md §4.3 and wit/nanopi-extension.wit for the
# guest interface a plugin must export.

# [[extensions]]
# path = "~/.nanopi/extensions/my-tool.wasm"

# A plugin that fetches arbitrary URLs — no finite host list to
# enumerate, so the wildcard is the honest way to say so.
# [[extensions]]
# path = "~/.nanopi/extensions/fetcher.wasm"
# allow_network = true
# url_allowlist = ["*"]

# [[extensions]]
# path = "~/.nanopi/extensions/"
# max_files = 16

# A plugin that only watches lifecycle events (e.g. an audit logger) —
# no tools, no commands, just `events`.
# [[extensions]]
# path = "~/.nanopi/extensions/audit-watcher.wasm"
# events = ["tool_execution_start", "session_start", "session_shutdown"]

# ─── API key: pick ONE of the two below ─────────────────────────────

# Option A — file (recommended). Path to a chmod-600 file containing
# just the token. An absolute path is safest — that's what `nanopi init`
# writes. `~/` and `$HOME/` are also expanded (on Windows, via the
# profile folder, since cmd and PowerShell don't set $HOME), and
# `~/.nanopi/...` follows NANOPI_HOME when you've set it.
# api_key_file = "~/.nanopi/api_key"

# Option B — inline (convenient for local dev). A stderr warning fires
# at startup so you don't accidentally commit this file with the key.
# api_key = "sk-..."

# ─── Trust default (optional) ───────────────────────────────────────

# Overrides the interactive trust prompt for project-local resources.
# One of: "trusted", "distrusted", "ask" (default).
# [trust]
# default = "trusted"

# ─── Hooks ──────────────────────────────────────────────────────────
#
# Each hook is a bash command run at a lifecycle event.
# Fields:
#   matcher  regex against tool_name (or session_id for session_*).
#            Defaults to "*" (match all) — required-looking blocks
#            that omit it work fine.
#   type     "command" (only value in v0.6+); optional.
#   command  Path/expression run via `bash -c "..."`. Supports ~,
#            $HOME, ${HOME}.
#   timeout  Milliseconds. Default 5000.
#
# The hook receives a JSON payload on stdin describing the event.
# Exit code 2 (or a JSON stdout {"decision":"block"}) blocks the
# tool call; anything else allows.
#
# All hook vectors are cumulative — multiple hooks of the same type
# fire in declaration order.
#
# ── Renamed in v0.12 — the old keys are errors, not warnings ────────
# nanopi used to borrow Claude Code's event names for four of these
# hooks. v0.12 renames them to PI's names, with no alias and no
# deprecation period: a config using one of the left-hand keys below
# fails to load, and the error names the right-hand replacement.
#
#   old key               | new key
#   -----------------------|------------------------
#   pre_tool_use           | tool_execution_start
#   post_tool_use          | tool_execution_end
#   user_prompt_submit     | input
#   session_end            | session_shutdown
#
# ── Session payload contract (all four session-lifecycle events) ────
# session_start / session_shutdown / session_before_compact /
# session_compact all send a JSON payload whose `arguments.reason`
# names why the event fired (e.g. "startup", "quit", "new", "resume",
# "fork", "import", "threshold", "manual") and whose `session_id` is
# ALWAYS the real session id — never the reason. A hook that used to
# read `session_id` to distinguish a compaction's cause must now read
# `arguments.reason` instead.

# Working versions of every script referenced below live in
# `examples/hooks/` — copy them to ~/.nanopi/hooks/ and see that
# directory's README.md for the payload shape and the three decision
# forms (refuse / rewrite / allow).

# Ex 1: veto dangerous rm invocations before bash runs them.
# [[hooks.tool_execution_start]]
# matcher = "^bash$"
# command = "~/.nanopi/hooks/check-rm-rf.sh"
# timeout = 5000

# Ex 2: log every tool result to a file for later audit.
# [[hooks.tool_execution_end]]
# matcher = "*"
# command = "cat >> ~/.nanopi/tool-audit.log"

# Ex 3: refuse prompts that contain a specific secret pattern.
# [[hooks.input]]
# command = "~/.nanopi/hooks/redact-secrets.sh"

# Ex 4: notify on session start (matcher defaults to "*"; session_id
# is what the matcher runs against for session_* events — the
# "reason" for the event, e.g. "startup" or "new", lives in
# arguments.reason on the JSON payload, not in the matcher subject).
# [[hooks.session_start]]
# command = "echo \"[nanopi] session started at $(date)\" >> ~/.nanopi/sessions.log"

# Ex 5: run cleanup on session exit (also fires on /new, /resume,
# /fork, /import — check arguments.reason if you only want the final
# quit). `examples/hooks/session-log.sh` shows that check.
# [[hooks.session_shutdown]]
# command = "~/.nanopi/hooks/session-log.sh"

# ── v0.11.0 lifecycle hooks ─────────────────────────────────────────
# These map to PI's before_agent_start / turn_start / turn_end /
# message_end. See docs/pi-vs-nanopi.md §4.3 for the full list.

# Ex 6: log every turn start for debugging.
# [[hooks.before_agent_start]]
# matcher = "*"
# command = "echo \"turn $TURN_COUNT started\" >> ~/.nanopi/turns.log"
# timeout = 2000

# Ex 7: audit each agent-loop iteration.
# [[hooks.turn_start]]
# matcher = "*"
# command = "echo \"[turn_start] iter=$ITERATION\" >> ~/.nanopi/agent.log"
# timeout = 2000

# Ex 8: track tool usage across iterations.
# [[hooks.turn_end]]
# matcher = "*"
# command = "echo \"[turn_end] had_tools=$HAD_TOOL_CALLS\" >> ~/.nanopi/agent.log"
# timeout = 2000

# Ex 9: fire a notification when a turn completes.
# [[hooks.message_end]]
# matcher = "*"
# command = "notify-send \"nanopi turn done\""
# timeout = 2000
