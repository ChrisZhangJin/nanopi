#!/data/data/com.termux/files/usr/bin/sh
# ---------------------------------------------------------------------------
# nanopi 启动器（Termux / Android）  —— 由它同时落地为 ~/nanopi 与 ~/nanopi-run
#
# 为什么必须包一层 proot：
#   nanopi 是 aarch64-unknown-linux-musl 的 Linux 静态二进制，内部 hickory-dns
#   走 Unix 分支，硬编码读 /etc/resolv.conf（源码无环境变量可覆盖）。
#   Android 的 /etc 指向只读的 /system/etc，里面没有 resolv.conf，于是：
#     error reading DNS system conf for hickory-dns: io error: os error 2
#   绕过 proot 直接执行真二进制，会看到更含糊的报错：
#     error: provider error: HTTP request failed: error sending request for url (...)
#   修法：proot 把自备的 resolv.conf 绑定到 /etc/resolv.conf。免 root、不改系统分区。
#
# 真二进制是 ~/nanopi.bin。请勿直接执行它（会 DNS 失败）。
#
# 用法:  ./nanopi                    启动交互式 TUI
#        ./nanopi -p "你好"          非交互打印模式
#        ./nanopi --version          纯本地，自动跳过 proot
#        NANOPI_PROXY=http://ip:port ./nanopi    没装 proot 时用代理绕开 DNS
# ---------------------------------------------------------------------------
export PREFIX=/data/data/com.termux/files/usr
export HOME=/data/data/com.termux/files/home
export PATH="$HOME:$PREFIX/bin:$PATH"
export TERM="${TERM:-xterm-256color}"
export TMPDIR="$PREFIX/tmp"

BIN="$HOME/nanopi.bin"
RESOLV="$HOME/.nanopi/resolv.conf"

# 真二进制缺失时给出可操作的指引，而不是一句 "not found"
if [ ! -x "$BIN" ]; then
  printf '\033[1;31m[错误]\033[0m 找不到真二进制 %s\n' "$BIN" >&2
  printf '        重装：  bash install-termux-nanopi.sh\n' >&2
  exit 127
fi

# --version / --help / -V / -h 完全离线，走 proot 只是白等，直接快路径
for a in "$@"; do
  case "$a" in
    --version|-V|--help|-h) exec "$BIN" "$@" ;;
  esac
done

# 自备 resolv.conf（只建一次，之后可自行增删 nameserver）
mkdir -p "$HOME/.nanopi"
if [ ! -s "$RESOLV" ]; then
  printf 'nameserver 223.5.5.5\nnameserver 119.29.29.29\n' > "$RESOLV"
fi

# 首次运行提示
if [ ! -f "$HOME/.nanopi/config.toml" ]; then
  printf '\033[1;33m[提示]\033[0m 尚无配置文件，接下来会进入 nanopi 首启向导。\n'
  printf '        可选 provider: OpenAI / DeepSeek / Anthropic / Gemini / Ollama / Custom\n\n'
fi

# 首选路线：proot 绑定 /etc/resolv.conf，走直连
if command -v proot >/dev/null 2>&1; then
  # -b $PREFIX/bin 到 /usr/bin：让 nanopi 内部执行 shell 命令时能找到 Termux 的
  # 工具链（git/grep/sed 等）。Android 的 /system/bin 里没有这些。
  exec proot -0 -r / \
    -b "$RESOLV:/etc/resolv.conf" \
    -b "$PREFIX/bin:/usr/bin" \
    -b "$PREFIX/lib:/usr/lib" \
    -b /dev -b /proc -b /sys \
    -w "$HOME" \
    "$BIN" "$@"
fi

# 退路：没装 proot 时用 IP 形式的代理把 DNS 完全绕开（不解析任何域名）
if [ -n "${NANOPI_PROXY:-}" ]; then
  export HTTP_PROXY="$NANOPI_PROXY"
  export HTTPS_PROXY="$NANOPI_PROXY"
  printf '\033[1;33m[提示]\033[0m 未装 proot，改用代理 %s 绕开 DNS\n' "$NANOPI_PROXY" >&2
  exec "$BIN" "$@"
fi

# 既没 proot 也没代理 —— 必然 DNS 失败，直接说清楚，别让用户对着
# "error sending request for url" 猜半天
printf '\033[1;31m[错误]\033[0m 未安装 proot，DNS 修复无法生效。\n' >&2
printf '        Android 没有 /etc/resolv.conf，nanopi 的解析器硬编码去读它，必然失败。\n' >&2
printf '        任选其一：\n' >&2
printf '          1) 装 proot（推荐）：  pkg install proot\n' >&2
printf '          2) 用代理绕过：        NANOPI_PROXY=http://192.168.32.101:18387 ./nanopi\n' >&2
exit 1
