# Rust
/target/

# Release binaries staged at repo root (built by cargo, not tracked)
/nanopi
/nanopi-*-linux-*
/nanopi-*-linux-*-musl
/nanopi-*-macos-*
/nanopi-*-windows-*.exe

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Smoke test scratch (created by tests/smoke.sh)
tests/smoke-tmp/
tests/*.tmp

# Bash tool overflow logs (under os tmpdir)
# Already in $TMPDIR, not in this repo, but listed for clarity if anyone
# redirects them here.
/tmp/nanopi-bash-*.log

# Local debug logs (created with NANOPI_DEBUG or verbose flags)
*.log
!docs/**/*.log

# Local `make pack` output (musl + UPX release binary)
/dist/

# Scratch notes staged for `gh release create --notes-file`
/.release-notes-*.md

# Credentials — never commit. `api_key_file` in config.toml points here.
/api_key

# Local runtime state: project-local config, skills, and TUI input
# history live under .nanopi/ and are per-machine.
/.nanopi/

# Dogfooding scratch: session transcripts dumped at the repo root and
# throwaway fixtures from manual TUI runs.
/*.jsonl
/.fake-home/
/calculator.html
/config.toml
/MEMORY.md